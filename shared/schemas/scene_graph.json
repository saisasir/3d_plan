{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "FloorPlanSceneGraph",
  "type": "object",
  "properties": {
    "metadata": {
      "type": "object",
      "properties": {
        "unit": { "type": "string", "enum": ["meters", "feet"] },
        "scale": { "type": "number" },
        "width": { "type": "number" },
        "height": { "type": "number" }
      }
    },
    "rooms": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": { "type": "string" },
          "type": { "type": "string" },
          "polygon": {
            "type": "array",
            "items": {
              "type": "array",
              "items": { "type": "number" },
              "minItems": 2,
              "maxItems": 2
            }
          }
        }
      }
    },
    "walls": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "points": {
            "type": "array",
            "items": {
              "type": "array",
              "items": { "type": "number" },
              "minItems": 2,
              "maxItems": 2
            }
          },
          "thickness": { "type": "number" }
        }
      }
    },
    "openings": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "type": { "type": "string", "enum": ["door", "window"] },
          "position": { "type": "array", "items": { "type": "number" } },
          "rotation": { "type": "number" },
          "width": { "type": "number" }
        }
      }
    },
    "furniture": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": { "type": "string" },
          "model_id": { "type": "string" },
          "position": { "type": "array", "items": { "type": "number" } },
          "rotation": { "type": "number" },
          "scale": { "type": "array", "items": { "type": "number" } }
        }
      }
    }
  }
}
